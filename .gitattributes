# Normalize text files to LF in the working tree and repository.
# Prevents CRLF (from git core.autocrlf on Windows) from failing `cargo fmt --check`
# (rustfmt.toml requires newline_style = "Unix").
* text=auto eol=lf

# Binary assets (never normalize).
*.png binary
*.jpg binary
*.exe binary
*.dll binary
*.pdb binary
*.msi binary
