{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OPC DA Desktop",
  "version": "0.1.0",
  "identifier": "top.metme.opc-da-desktop",
  "build": {
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OPC DA Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US", "zh-CN"]
      }
    }
  }
}